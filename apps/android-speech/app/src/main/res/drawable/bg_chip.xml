<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_background_active" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/system_blue" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0E0E6" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_background" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#D1D1D6" />
        </shape>
    </item>
</selector>
